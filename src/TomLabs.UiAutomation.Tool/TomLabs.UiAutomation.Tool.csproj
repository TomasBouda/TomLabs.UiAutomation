<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TomLabs.UiAutomation.Tool</RootNamespace>
    <AssemblyName>tomlabs-ui</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>tomlabs-ui</ToolCommandName>
    <PackageId>TomLabs.UiAutomation.Tool</PackageId>
    <Description>Command-line driver for apps that embed TomLabs.UiAutomation: builds, starts headless, calls endpoints, saves screenshots and dumps the visual tree.</Description>
    <PackageTags>avalonia;automation;headless;screenshot;dotnet-tool</PackageTags>
  </PropertyGroup>
</Project>
